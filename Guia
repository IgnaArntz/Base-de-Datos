-- ============================================================

DECLARE

    CURSOR c_empleados IS
        SELECT *
        FROM empleado
        WHERE sueldo >= 500000;

    v_contador NUMBER := 0;
    v_suma NUMBER := 0;

BEGIN

    FOR registro IN c_empleados
    LOOP

        v_contador := v_contador + 1;
        v_suma := v_suma + registro.sueldo;

        DBMS_OUTPUT.PUT_LINE(
            'Empleado: ' || registro.nombre
        );

    END LOOP;

    DBMS_OUTPUT.PUT_LINE(
        'Cantidad: ' || v_contador
    );

    DBMS_OUTPUT.PUT_LINE(
        'Suma: ' || v_suma
    );

END;
