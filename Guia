-- ============================================================
-- 27. CONTADOR
-- ============================================================

DECLARE

    v_contador NUMBER := 0;

BEGIN

    FOR registro IN (
        SELECT *
        FROM empleado
    )
    LOOP

        v_contador := v_contador + 1;

        DBMS_OUTPUT.PUT_LINE(
            'Registro: ' || v_contador
        );

    END LOOP;

END;
/

-- ============================================================
-- 28. ACUMULADOR
-- ============================================================

DECLARE

    v_suma NUMBER := 0;

BEGIN

    FOR registro IN (
        SELECT *
        FROM empleado
    )
    LOOP

        v_suma := v_suma + registro.sueldo;

    END LOOP;

    DBMS_OUTPUT.PUT_LINE(
        'Suma total: ' || v_suma
    );

END;
/

-- ============================================================
-- 29. PROMEDIO
-- ============================================================

DECLARE

    v_suma NUMBER := 0;
    v_contador NUMBER := 0;
    v_promedio NUMBER;

BEGIN

    FOR registro IN (
        SELECT *
        FROM empleado
    )
    LOOP

        v_suma := v_suma + registro.sueldo;
        v_contador := v_contador + 1;

    END LOOP;

    IF v_contador > 0 THEN
        v_promedio := v_suma / v_contador;
    END IF;

    DBMS_OUTPUT.PUT_LINE(
        'Promedio: ' || v_promedio
    );

END;
/

