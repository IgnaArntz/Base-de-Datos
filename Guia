-- ============================================================
-- 15. JOIN
-- ============================================================
--
-- JOIN combina informacion de tablas relacionadas.
--
-- ============================================================

SELECT
    p.codigo,
    p.nombre,
    p.precio,
    f.nombre_fabricante
FROM producto p
JOIN fabricante f
    ON p.codigo_fabricante = f.codigo_fabricante;

-- ============================================================
-- 16. ON
-- ============================================================
--
-- ON indica la condicion que relaciona las tablas.
--
-- ============================================================

SELECT
    p.nombre,
    f.nombre_fabricante
FROM producto p
JOIN fabricante f
    ON p.codigo_fabricante = f.codigo_fabricante;

-- ============================================================
