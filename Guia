-- ============================================================
-- 5. IF
-- ============================================================

DECLARE
    v_sueldo NUMBER := 700000;
BEGIN
    IF v_sueldo >= 700000 THEN
        DBMS_OUTPUT.PUT_LINE('Sueldo alto');
    END IF;
END;
/

-- ============================================================
-- 6. IF + ELSE
-- ============================================================

DECLARE
    v_edad NUMBER := 20;
BEGIN
    IF v_edad >= 18 THEN
        DBMS_OUTPUT.PUT_LINE('Adulto');
    ELSE
        DBMS_OUTPUT.PUT_LINE('Menor');
    END IF;
END;
/

-- ============================================================
-- 7. IF + ELSIF + ELSE
-- ============================================================

DECLARE
    v_nota NUMBER := 5;
BEGIN
    IF v_nota >= 6 THEN
        DBMS_OUTPUT.PUT_LINE('Resultado: Excelente');
    ELSIF v_nota >= 4 THEN
        DBMS_OUTPUT.PUT_LINE('Resultado: Aprobado');
    ELSE
        DBMS_OUTPUT.PUT_LINE('Resultado: Reprobado');
    END IF;
END;
/

-- ============================================================
-- 8. CASE
-- ============================================================

DECLARE
    v_nota NUMBER := 5;
BEGIN
    CASE
        WHEN v_nota >= 6 THEN
            DBMS_OUTPUT.PUT_LINE('Resultado: Excelente');

        WHEN v_nota >= 4 THEN
            DBMS_OUTPUT.PUT_LINE('Resultado: Aprobado');

        ELSE
            DBMS_OUTPUT.PUT_LINE('Resultado: Reprobado');
    END CASE;
END;
/

