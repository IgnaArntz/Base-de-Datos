-- 61. MAPA DE RECONOCIMIENTO
-- ============================================================
--
-- Si necesitas:
--
-- UNA COLUMNA -> %TYPE
-- UNA FILA COMPLETA -> %ROWTYPE
-- AGRUPAR DATOS -> RECORD
-- OBTENER UNA FILA -> SELECT INTO
-- VARIAS FILAS -> CURSOR
-- RECORRER AUTOMATICAMENTE -> FOR
-- CONTROLAR MANUALMENTE -> OPEN / FETCH / LOOP / CLOSE
-- FILTRAR -> WHERE
-- ORDENAR -> ORDER BY
-- RELACIONAR TABLAS -> JOIN
-- CONDICION DEL JOIN -> ON
-- CONSERVAR TODAS LAS FILAS IZQUIERDAS -> LEFT JOIN
-- REEMPLAZAR NULL -> NVL
-- CONTAR -> COUNT
-- SUMAR -> SUM
-- PROMEDIAR -> AVG
-- MAYOR -> MAX
-- MENOR -> MIN
-- CONTAR MANUALMENTE -> CONTADOR
-- SUMAR MANUALMENTE -> ACUMULADOR
-- PROMEDIO MANUAL -> SUMA / CONTADOR
-- VARIOS ELEMENTOS ORDENADOS -> VARRAY
-- AGREGAR POSICION -> EXTEND
-- MEDIR TEXTO -> LENGTH
-- MOSTRAR RESULTADO -> DBMS_OUTPUT.PUT_LINE
-- UNIR TEXTO Y VALORES -> ||
-- PEDIR VALOR AL EJECUTAR -> &
--
-- ============================================================
